{
  "entities": {
    "Property": {
      "title": "Property",
      "description": "Real estate property for rent",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "address": { "type": "string" },
        "rentAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["available", "rented"] },
        "imageUrl": { "type": "string" },
        "iptuAmount": { "type": "number", "description": "Monthly IPTU fee amount" },
        "condoAmount": { "type": "number", "description": "Monthly condominium fee amount" },
        "requiresGuarantor": { "type": "boolean", "description": "Whether a guarantor (fiador) is required" },
        "requiresDeposit": { "type": "boolean", "description": "Whether a security deposit (caução) is required" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "title", "address", "rentAmount", "status", "imageUrl"]
    },
    "Tenant": {
      "title": "Tenant",
      "description": "Person renting a property",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "cpf": { "type": "string" },
        "rg": { "type": "string" },
        "birthDate": { "type": "string", "format": "date" },
        "profession": { "type": "string" },
        "monthlyIncome": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "name", "email", "phone", "cpf"]
    },
    "Contract": {
      "title": "Contract",
      "description": "Rental contract between owner and tenant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "propertyId": { "type": "string" },
        "tenantId": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "rentAmount": { "type": "number" },
        "dayOfPayment": { "type": "number" },
        "documentUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "propertyId", "tenantId", "startDate", "endDate", "rentAmount", "dayOfPayment"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Record of a rent payment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "contractId": { "type": "string" },
        "dueDate": { "type": "string", "format": "date" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["paid", "pending", "overdue"] },
        "paymentDate": { "type": "string", "format": "date-time" },
        "boletoLink": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "contractId", "dueDate", "amount", "status"]
    },
    "Landlord": {
      "title": "Landlord",
      "description": "Property owner or manager",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "cpfCnpj": { "type": "string" },
        "pixKey": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "name", "email", "phone", "cpfCnpj"]
    },
    "AppSettings": {
      "title": "App Settings",
      "description": "Global application settings",
      "type": "object",
      "properties": {
        "logoUrl": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["logoUrl"]
    },
    "AutomationConfig": {
      "title": "Automation Config",
      "description": "Tenant invoice emission and webhook delivery rules",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "enabled": { "type": "boolean" },
        "daysAhead": { "type": "number" },
        "emailDelivery": { "type": "boolean" },
        "whatsappDelivery": { "type": "boolean" },
        "webhookUrl": { "type": "string" },
        "secretToken": { "type": "string" },
        "events": { "type": "array" }
      },
      "required": ["id", "ownerId", "enabled", "daysAhead", "webhookUrl"]
    },
    "WebhookLog": {
      "title": "Webhook Log",
      "description": "Record of a webhook event post attempt",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "event": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "payload": { "type": "string" },
        "url": { "type": "string" },
        "status": { "type": "string" },
        "response": { "type": "string" }
      },
      "required": ["id", "ownerId", "event", "timestamp", "payload", "url", "status"]
    }
  },
  "firestore": {
    "properties/{propertyId}": {
      "schema": "Property",
      "description": "Collection of all properties"
    },
    "tenants/{tenantId}": {
      "schema": "Tenant",
      "description": "Collection of all tenants"
    },
    "contracts/{contractId}": {
      "schema": "Contract",
      "description": "Collection of all contracts"
    },
    "payments/{paymentId}": {
      "schema": "Payment",
      "description": "Collection of all payments"
    },
    "landlords/{landlordId}": {
      "schema": "Landlord",
      "description": "Collection of all landlords"
    },
    "settings/{settingId}": {
      "schema": "AppSettings",
      "description": "Global application settings documents"
    },
    "automations/{userId}": {
      "schema": "AutomationConfig",
      "description": "Automation configuration settings document for each user"
    },
    "webhook_logs/{logId}": {
      "schema": "WebhookLog",
      "description": "Log entry of triggered webhook events"
    }
  }
}
