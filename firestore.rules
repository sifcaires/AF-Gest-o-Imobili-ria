rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(data) {
      return isSignedIn() && (data.ownerId == request.auth.uid || request.auth.token.email == 'admin@email.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Matching all collections
    match /properties/{id} {
      allow read, write: if isOwner(resource.data) || (isSignedIn() && request.method == 'create' && request.resource.data.ownerId == request.auth.uid);
    }
    
    match /tenants/{id} {
      allow read, write: if isOwner(resource.data) || (isSignedIn() && request.method == 'create' && request.resource.data.ownerId == request.auth.uid);
    }
    
    match /contracts/{id} {
      allow read, write: if isOwner(resource.data) || (isSignedIn() && request.method == 'create' && request.resource.data.ownerId == request.auth.uid);
    }
    
    match /payments/{id} {
      allow read, write: if isOwner(resource.data) || (isSignedIn() && request.method == 'create' && request.resource.data.ownerId == request.auth.uid);
    }
    
    match /landlords/{id} {
      allow read, write: if isOwner(resource.data) || (isSignedIn() && request.method == 'create' && request.resource.data.ownerId == request.auth.uid);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
