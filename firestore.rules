rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 1. Global Safety Net ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- 2. Reusable Primitives & Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(data) {
      return isSignedIn() && data.ownerId == request.auth.uid;
    }

    // Role-based retrieval by checking the authenticated user's role in the /users/{userId} document.
    // If the user document does not exist yet (e.g. during very first signup check), these return false.
    function isUserDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isDirector() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'admin@email.com' || 
        request.auth.token.email.lower() == 'sifcaires@gmail.com' || 
        (isUserDocExists() && getUserRole() == 'director')
      );
    }

    function isAdmin() {
      return isDirector();
    }

    function isLandlordPleno() {
      return isSignedIn() && (
        isAdmin() || 
        (isUserDocExists() && getUserRole() == 'landlord_pleno')
      );
    }

    function isBroker() {
      return isSignedIn() && (
        isAdmin() || 
        (isUserDocExists() && getUserRole() == 'broker')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper functions to retrieve state properties from request payload.
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // --- 3. Schema & Role-Based Match Rules ---

    // Global settings collection (logo, app parameters)
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Properties collection
    match /properties/{propertyId} {
      allow read: if isOwner(existing()) || isLandlordPleno() || isBroker() || isAdmin();
      allow create: if isSignedIn() && isValidId(propertyId) 
                     && (incoming().ownerId == request.auth.uid || isBroker() || isAdmin());
      allow update: if isOwner(existing()) || isBroker() || isAdmin();
      allow delete: if isOwner(existing()) || isAdmin();
    }

    // Tenants collection
    match /tenants/{tenantId} {
      allow read: if isOwner(existing()) || isLandlordPleno() || isBroker() || isAdmin();
      allow create: if isSignedIn() && isValidId(tenantId)
                     && (incoming().ownerId == request.auth.uid || isBroker() || isAdmin());
      allow update: if isOwner(existing()) || isBroker() || isAdmin();
      allow delete: if isOwner(existing()) || isAdmin();
    }

    // Contracts collection
    match /contracts/{contractId} {
      allow read: if isOwner(existing()) || isLandlordPleno() || isBroker() || isAdmin();
      allow create: if isSignedIn() && isValidId(contractId)
                     && (incoming().ownerId == request.auth.uid || isBroker() || isAdmin());
      allow update: if isOwner(existing()) || isBroker() || isAdmin();
      allow delete: if isOwner(existing()) || isAdmin();
    }

    // Payments collection
    match /payments/{paymentId} {
      allow read: if isOwner(existing()) || isLandlordPleno() || isBroker() || isAdmin();
      allow create: if isSignedIn() && isValidId(paymentId)
                     && (incoming().ownerId == request.auth.uid || isBroker() || isAdmin());
      allow update: if isOwner(existing()) || isBroker() || isAdmin();
      allow delete: if isOwner(existing()) || isAdmin();
    }

    // Landlords collection
    match /landlords/{landlordId} {
      allow get, list: if isOwner(existing()) || isLandlordPleno() || isBroker() || isAdmin() || 
                       (isSignedIn() && existing().email.lower() == request.auth.token.email.lower());
      allow create: if isSignedIn() && isValidId(landlordId)
                     && (incoming().ownerId == request.auth.uid || isBroker() || isAdmin());
      allow update: if isOwner(existing()) || isBroker() || isAdmin();
      allow delete: if isOwner(existing()) || isAdmin();
    }

    // Brokers collection
    match /brokers/{brokerId} {
      allow read: if isOwner(existing()) || isLandlordPleno() || isBroker() || isAdmin() || 
                   (isSignedIn() && existing().email.lower() == request.auth.token.email.lower());
      allow create: if isSignedIn() && isValidId(brokerId)
                     && (incoming().ownerId == request.auth.uid || isBroker() || isAdmin());
      allow update: if isOwner(existing()) || isBroker() || isAdmin();
      allow delete: if isOwner(existing()) || isAdmin();
    }

    // Automations configuration
    match /automations/{userId} {
      allow read, write: if isSignedIn() && (
        userId == request.auth.uid || 
        (resource != null && isOwner(existing())) || 
        (request.resource != null && incoming().ownerId == request.auth.uid) || 
        isAdmin()
      );
    }

    // Webhook delivery logs
    match /webhook_logs/{id} {
      allow read: if resource != null && (isOwner(existing()) || isAdmin());
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update, delete: if isOwner(existing()) || isAdmin();
    }

    // Users registered profiles
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      // Elevate security on user registration / role changes:
      // Regular users are allowed to create or modify their own basic profile, but cannot self-assign/elevate roles or change them once set unless they are Director/Admin.
      allow write: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId && (
          // On registration creation:
          (resource == null && (
            incoming().role == "landlord" || 
            incoming().role == "landlord_pleno" || 
            incoming().role == "broker" || 
            (incoming().role == "director" && (request.auth.token.email.lower() == "admin@email.com" || request.auth.token.email.lower() == "sifcaires@gmail.com"))
          )) ||
          // On profile updates:
          (resource != null && (
            !('role' in incoming()) || 
            incoming().role == existing().role
          ))
        )
      );
    }
  }
}
