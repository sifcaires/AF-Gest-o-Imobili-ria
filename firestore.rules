rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(data) {
      return isSignedIn() && data.ownerId == request.auth.uid;
    }

    function isDirector() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'director';
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@email.com' || 
        request.auth.token.email == 'sifcaires@gmail.com' || 
        isDirector()
      );
    }

    function isLandlordPleno() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'landlord_pleno';
    }

    function isBroker() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'broker';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Matching all collections
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /properties/{id} {
      allow read: if isOwner(resource.data) || isLandlordPleno() || isBroker() || isAdmin();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(resource.data) || isAdmin();
    }
    
    match /tenants/{id} {
      allow read: if isOwner(resource.data) || isLandlordPleno() || isBroker() || isAdmin();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(resource.data) || isAdmin();
    }
    
    match /contracts/{id} {
      allow read: if isOwner(resource.data) || isLandlordPleno() || isBroker() || isAdmin();
      allow create: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || isBroker());
      allow update, delete: if isOwner(resource.data) || isBroker() || isAdmin();
    }
    
    match /payments/{id} {
      allow read: if isOwner(resource.data) || isLandlordPleno() || isBroker() || isAdmin();
      allow create: if isSignedIn() && (request.resource.data.ownerId == request.auth.uid || isBroker());
      allow update, delete: if isOwner(resource.data) || isBroker() || isAdmin();
    }
    
    match /landlords/{id} {
      allow get, list: if isOwner(resource.data) || isLandlordPleno() || isBroker() || isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(resource.data) || isAdmin();
    }

    match /brokers/{id} {
      allow read: if isOwner(resource.data) || isLandlordPleno() || isBroker() || isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(resource.data) || isAdmin();
    }

    match /automations/{id} {
      allow read, write: if isSignedIn() && (id == request.auth.uid || (resource != null && isOwner(resource.data)) || (request.resource != null && request.resource.data.ownerId == request.auth.uid) || isAdmin());
    }

    match /webhook_logs/{id} {
      allow read: if resource != null && (isOwner(resource.data) || isAdmin());
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(resource.data) || isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
