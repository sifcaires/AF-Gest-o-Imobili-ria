rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(data) {
      return isSignedIn() && (data.ownerId == request.auth.uid || isAdmin());
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == 'admin@email.com' || request.auth.token.email == 'sifcaires@gmail.com');
    }

    function isLandlordPleno() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'landlord_pleno';
    }

    function isBroker() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'broker';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Matching all collections
    match /settings/{id} {
      allow read: if true; // Public settings like logo should be readable by all? Or at least all signed in?
      allow write: if isAdmin();
    }
    
    match /properties/{id} {
      allow read: if isOwner(resource.data) || isLandlordPleno() || isBroker() || (isSignedIn() && request.method == 'create' && request.resource.data.ownerId == request.auth.uid);
      allow write: if isOwner(resource.data) || (isSignedIn() && request.method == 'create' && request.resource.data.ownerId == request.auth.uid);
    }
    
    match /tenants/{id} {
      allow read: if isOwner(resource.data) || isLandlordPleno() || isBroker() || (isSignedIn() && request.method == 'create' && request.resource.data.ownerId == request.auth.uid);
      allow write: if isOwner(resource.data) || (isSignedIn() && request.method == 'create' && request.resource.data.ownerId == request.auth.uid);
    }
    
    match /contracts/{id} {
      allow read: if isOwner(resource.data) || isLandlordPleno() || isBroker() || (isSignedIn() && request.method == 'create' && request.resource.data.ownerId == request.auth.uid);
      allow write: if isOwner(resource.data) || (isSignedIn() && request.method == 'create' && request.resource.data.ownerId == request.auth.uid) || isBroker();
    }
    
    match /payments/{id} {
      allow read: if isOwner(resource.data) || isLandlordPleno() || isBroker() || (isSignedIn() && request.method == 'create' && request.resource.data.ownerId == request.auth.uid);
      allow write: if isOwner(resource.data) || (isSignedIn() && request.method == 'create' && request.resource.data.ownerId == request.auth.uid) || isBroker();
    }
    
    match /landlords/{id} {
      allow get: if isOwner(resource.data) || isLandlordPleno() || isBroker() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow list: if isOwner(resource.data) || isLandlordPleno() || isBroker() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow write: if isOwner(resource.data) || (isSignedIn() && request.method == 'create' && request.resource.data.ownerId == request.auth.uid);
    }

    match /brokers/{id} {
      allow read: if isOwner(resource.data) || isLandlordPleno() || isBroker() || (isSignedIn() && request.method == 'create' && request.resource.data.ownerId == request.auth.uid) || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow write: if isOwner(resource.data) || (isSignedIn() && request.method == 'create' && request.resource.data.ownerId == request.auth.uid);
    }

    match /automations/{id} {
      allow read, write: if isSignedIn() && (id == request.auth.uid || (resource != null && resource.data.ownerId == request.auth.uid) || (request.resource != null && request.resource.data.ownerId == request.auth.uid));
    }

    match /webhook_logs/{id} {
      allow read, write: if (resource != null && isOwner(resource.data)) || (isSignedIn() && request.method == 'create' && request.resource.data.ownerId == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
