rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 1. Global Safety Net ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- 2. Reusable Primitives & Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(data) {
      return isSignedIn() && data.ownerId == request.auth.uid;
    }

    function isOwnerOrPleno(data) {
      return isSignedIn() && (
        data.ownerId == request.auth.uid || 
        (isLandlordPleno() && (data.ownerId == getUserOwnerId() || data.ownerId == request.auth.uid))
      );
    }

    // Role-based retrieval by checking the authenticated user's role in the /users/{userId} document.
    // If the user document does not exist yet (e.g. during very first signup check), these return false.
    function isUserDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function getUserOwnerId() {
      return isUserDocExists() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownerId : null;
    }

    function isDirector() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'admin@email.com' || 
        request.auth.token.email.lower() == 'sifcaires@gmail.com' || 
        (isUserDocExists() && getUserRole() == 'director')
      );
    }

    function isAdmin() {
      return isDirector();
    }

    function isLandlordPleno() {
      return isSignedIn() && (
        isAdmin() || 
        (isUserDocExists() && getUserRole() == 'landlord_pleno')
      );
    }

    function isBroker() {
      return isSignedIn() && (
        isAdmin() || 
        (isUserDocExists() && getUserRole() == 'broker')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper functions to retrieve state properties from request payload.
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // --- 3. Schema & Role-Based Match Rules ---

    // Global settings collection (logo, app parameters)
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Properties collection
    match /properties/{propertyId} {
      allow read: if isOwnerOrPleno(existing()) || isBroker() || isAdmin();
      allow create: if isSignedIn() && isValidId(propertyId) 
                     && (incoming().ownerId == request.auth.uid || (isLandlordPleno() && incoming().ownerId == getUserOwnerId()) || isBroker() || isAdmin());
      allow update: if isOwnerOrPleno(existing()) || isBroker() || isAdmin();
      allow delete: if isOwnerOrPleno(existing()) || isAdmin();
    }

    // Tenants collection
    match /tenants/{tenantId} {
      allow read: if isOwnerOrPleno(existing()) || isBroker() || isAdmin();
      allow create: if isSignedIn() && isValidId(tenantId)
                     && (incoming().ownerId == request.auth.uid || (isLandlordPleno() && incoming().ownerId == getUserOwnerId()) || isBroker() || isAdmin());
      allow update: if isOwnerOrPleno(existing()) || isBroker() || isAdmin();
      allow delete: if isOwnerOrPleno(existing()) || isAdmin();
    }

    // Contracts collection
    match /contracts/{contractId} {
      allow read: if isOwnerOrPleno(existing()) || isBroker() || isAdmin();
      allow create: if isSignedIn() && isValidId(contractId)
                     && (incoming().ownerId == request.auth.uid || (isLandlordPleno() && incoming().ownerId == getUserOwnerId()) || isBroker() || isAdmin());
      allow update: if isOwnerOrPleno(existing()) || isBroker() || isAdmin();
      allow delete: if isOwnerOrPleno(existing()) || isAdmin();
    }

    // Payments collection
    match /payments/{paymentId} {
      allow read: if isOwnerOrPleno(existing()) || isBroker() || isAdmin();
      allow create: if isSignedIn() && isValidId(paymentId)
                     && (incoming().ownerId == request.auth.uid || (isLandlordPleno() && incoming().ownerId == getUserOwnerId()) || isBroker() || isAdmin());
      allow update: if isOwnerOrPleno(existing()) || isBroker() || isAdmin();
      allow delete: if isOwnerOrPleno(existing()) || isAdmin();
    }

    // Landlords collection
    match /landlords/{landlordId} {
      allow get, list: if isOwnerOrPleno(existing()) || isBroker() || isAdmin() || 
                       (isSignedIn() && (existing().email == request.auth.token.email || existing().email == request.auth.token.email.lower()));
      allow create: if isSignedIn() && isValidId(landlordId)
                     && (incoming().ownerId == request.auth.uid || (isLandlordPleno() && incoming().ownerId == getUserOwnerId()) || isBroker() || isAdmin());
      allow update: if isOwnerOrPleno(existing()) || isBroker() || isAdmin();
      allow delete: if isOwnerOrPleno(existing()) || isAdmin();
    }

    // Brokers collection
    match /brokers/{brokerId} {
      allow read: if isOwnerOrPleno(existing()) || isBroker() || isAdmin() || 
                   (isSignedIn() && (existing().email == request.auth.token.email || existing().email == request.auth.token.email.lower()));
      allow create: if isSignedIn() && isValidId(brokerId)
                     && (incoming().ownerId == request.auth.uid || (isLandlordPleno() && incoming().ownerId == getUserOwnerId()) || isBroker() || isAdmin());
      allow update: if isOwnerOrPleno(existing()) || isBroker() || isAdmin();
      allow delete: if isOwnerOrPleno(existing()) || isAdmin();
    }

    // Automations configuration
    match /automations/{userId} {
      allow read, write: if isSignedIn() && (
        userId == request.auth.uid || 
        (resource != null && isOwnerOrPleno(existing())) || 
        (request.resource != null && (incoming().ownerId == request.auth.uid || (isLandlordPleno() && incoming().ownerId == getUserOwnerId()))) || 
        isAdmin()
      );
    }

    // Webhook delivery logs
    match /webhook_logs/{id} {
      allow read: if resource != null && (isOwnerOrPleno(existing()) || isAdmin());
      allow create: if isSignedIn() && (incoming().ownerId == request.auth.uid || (isLandlordPleno() && incoming().ownerId == getUserOwnerId()));
      allow update, delete: if isOwnerOrPleno(existing()) || isAdmin();
    }

    // Inspections (Vistorias por Foto) collection
    match /inspections/{inspectionId} {
      allow read: if isOwnerOrPleno(existing()) || isBroker() || isAdmin();
      allow create: if isSignedIn() && isValidId(inspectionId)
                     && (incoming().ownerId == request.auth.uid || (isLandlordPleno() && incoming().ownerId == getUserOwnerId()) || isBroker() || isAdmin());
      allow update: if isOwnerOrPleno(existing()) || isBroker() || isAdmin();
      allow delete: if isOwnerOrPleno(existing()) || isAdmin();
    }

    // Users registered profiles
    match /users/{userId} {
      allow get: if isAdmin() || 
                   (isSignedIn() && request.auth.uid == userId) || 
                   (isSignedIn() && resource.data.ownerId == request.auth.uid) ||
                   (isSignedIn() && (
                     resource.data.role == "director" || 
                     resource.data.role == "landlord" || 
                     resource.data.role == "landlord_pleno" ||
                     resource.data.role == "broker"
                   ));
      
      allow list: if isAdmin() || 
                    (isSignedIn() && resource.data.ownerId == request.auth.uid) ||
                    (isSignedIn() && getUserOwnerId() != null && resource.data.ownerId == getUserOwnerId());
      
      allow create: if isAdmin() || (
        isSignedIn() && request.auth.uid == userId && (
          incoming().role == "landlord" || 
          incoming().role == "landlord_pleno" || 
          incoming().role == "broker" || 
          (incoming().role == "director" && (request.auth.token.email.lower() == "admin@email.com" || request.auth.token.email.lower() == "sifcaires@gmail.com"))
        )
      );

      allow update: if isAdmin() || (
        // Allow Locador Master to update their linked users (except changing role to director)
        isSignedIn() && 
        resource != null && 
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().role != "director"
      ) || (
        isSignedIn() && request.auth.uid == userId && 
        resource != null && (
          !('role' in incoming()) || 
          incoming().role == existing().role
        )
      );

      allow delete: if isAdmin() || (
        // Allow Locador Master to delete their linked users (except director accounts)
        isSignedIn() && 
        resource != null && 
        existing().ownerId == request.auth.uid &&
        existing().role != "director"
      );
    }
  }
}
