rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user has elevated privileges via Firestore
    function isStaff() {
      return request.auth != null && (
        request.auth.token.email == 'admin@email.com' || 
        request.auth.token.email == 'sifcaires@gmail.com' ||
        (
          firestore.exists(/databases/\(default\)/documents/users/$(request.auth.uid)) && (
            firestore.get(/databases/\(default\)/documents/users/$(request.auth.uid)).data.role == 'landlord_pleno' ||
            firestore.get(/databases/\(default\)/documents/users/$(request.auth.uid)).data.role == 'broker' ||
            firestore.get(/databases/\(default\)/documents/users/$(request.auth.uid)).data.role == 'director'
          )
        )
      );
    }

    match /contracts/{userId}/{allPaths=**} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isStaff();
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024 // 10MB
                   && (request.resource.contentType.matches('application/pdf') || request.resource.contentType.matches('image/.*'));
    }

    match /profiles/{userId}/{allPaths=**} {
      allow read: if true; // Profile photos are public
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024 // 2MB
                   && request.resource.contentType.matches('image/.*');
    }

    match /brand/{allPaths=**} {
      allow read: if true; // Logo is public
      allow write: if request.auth != null 
                   && (request.auth.token.email == 'admin@email.com' || request.auth.token.email == 'sifcaires@gmail.com' || isStaff())
                   && request.resource.size < 2 * 1024 * 1024 // 2MB
                   && request.resource.contentType.matches('image/.*');
    }

    match /landlords/{landlordId}/{allPaths=**} {
      allow read: if request.auth != null; // Registered landlords docs visible to all team? Or just owner?
      allow write: if request.auth != null 
                   && request.resource.size < 5 * 1024 * 1024 // 5MB
                   && (request.resource.contentType.matches('application/pdf') || request.resource.contentType.matches('image/.*'));
    }
  }
}
